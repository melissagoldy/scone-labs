<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <description>Creates a workout session, exercises, and sets from the selected template, then opens exercise logging directly with inline previous results.</description>
    <dynamicChoiceSets>
        <name>workoutTemplateChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>Workout_Template__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Start Workout {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Start Workout</label>
    <loops>
        <name>Loop_Planned_Exercises</name>
        <label>Loop Planned Exercises</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Planned_Exercises</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Create_Workout_Exercise</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Launch_Log_Workout</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Set_1</name>
        <label>Create Set 1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Set_2</targetReference>
        </connector>
        <inputAssignments>
            <field>Set_Number__c</field>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Workout_Exercise__c</field>
            <value>
                <elementReference>varWorkoutExerciseId</elementReference>
            </value>
        </inputAssignments>
        <object>Workout_Set__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Set_2</name>
        <label>Create Set 2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loop_Planned_Exercises</targetReference>
        </connector>
        <inputAssignments>
            <field>Set_Number__c</field>
            <value>
                <numberValue>2.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Workout_Exercise__c</field>
            <value>
                <elementReference>varWorkoutExerciseId</elementReference>
            </value>
        </inputAssignments>
        <object>Workout_Set__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Workout_Exercise</name>
        <label>Create Workout Exercise</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>varWorkoutExerciseId</assignRecordIdToReference>
        <connector>
            <targetReference>Create_Set_1</targetReference>
        </connector>
        <inputAssignments>
            <field>Exercise_Order__c</field>
            <value>
                <elementReference>Loop_Planned_Exercises.Exercise_Order__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Exercise__c</field>
            <value>
                <elementReference>Loop_Planned_Exercises.Exercise__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Target_Reps__c</field>
            <value>
                <elementReference>Loop_Planned_Exercises.Enter_the_planned_number_of_sets_for_thi__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Target_Sets__c</field>
            <value>
                <elementReference>Loop_Planned_Exercises.Target_Sets__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Workout_Session__c</field>
            <value>
                <elementReference>varWorkoutSessionId</elementReference>
            </value>
        </inputAssignments>
        <object>Workout_Exercise__c</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Workout_Session</name>
        <label>Create Workout Session</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>varWorkoutSessionId</assignRecordIdToReference>
        <connector>
            <targetReference>Get_Planned_Exercises</targetReference>
        </connector>
        <inputAssignments>
            <field>Workout_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Workout_Template__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <object>Workout_Session__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Current_Workout_Template</name>
        <label>Get Current Workout Template</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Workout_Session</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Workout_Template__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Planned_Exercises</name>
        <label>Get Planned Exercises</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Planned_Exercises</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Workout_Template__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Planned_Exercise__c</object>
        <sortField>Exercise_Order__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Current_Workout_Template</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Launch_Log_Workout</name>
        <label>Launch Log Workout</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Log_Workout</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>varWorkoutSessionId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Stores the Workout Exercise Id created inside the loop</description>
        <name>varWorkoutExerciseId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Stores the Id of the Workout Session created by the flow.</description>
        <name>varWorkoutSessionId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
