    <decisions>
        <name>Check_Workout_Limit</name>
        <label>Check Workout Limit</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <defaultConnector>
            <targetReference>Loop_Completed_Workouts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Limit Reached</defaultConnectorLabel>
        <rules>
            <name>Include_Workout</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>workoutCount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Workout_To_Summary</targetReference>
            </connector>
            <label>Include Workout</label>
        </rules>
    </decisions>

    <decisions>
        <name>Latest_Workout_Found</name>
        <label>Latest Workout Found?</label>
        <locationX>176</locationX>
        <locationY>824</locationY>
        <defaultConnector>
            <targetReference>Add_No_Workouts_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Completed Workout</defaultConnectorLabel>
        <rules>
            <name>Workout_Was_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Latest_Completed_Workout.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Latest_Workout_Header</targetReference>
            </connector>
            <label>Workout Was Found</label>
        </rules>
    </decisions>

    <description>Returns an Agentforce-friendly summary of the current user&apos;s five most recent completed workout sessions and detailed exercise and set data for the latest completed workout.</description>

    <formulas>
        <name>Summary_Header</name>
        <dataType>String</dataType>
        <expression>&quot;Recent completed workouts from Salesforce:&quot; &amp; BR()</expression>
    </formulas>

    <formulas>
        <name>Current_Workout_Line</name>
        <dataType>String</dataType>
        <expression>&quot;- &quot; &amp;
TEXT({!Loop_Completed_Workouts.Workout_Date__c}) &amp;
&quot; | Template: &quot; &amp;
BLANKVALUE({!Loop_Completed_Workouts.Workout_Template__r.Name}, &quot;Not recorded&quot;) &amp;
&quot; | Starting energy: &quot; &amp;
BLANKVALUE(TEXT({!Loop_Completed_Workouts.Energy_Level__c}), &quot;Not recorded&quot;) &amp;
&quot; | Outcome: &quot; &amp;
BLANKVALUE(TEXT({!Loop_Completed_Workouts.Workout_Outcome__c}), &quot;Not recorded&quot;) &amp;
&quot; | Would repeat: &quot; &amp;
IF({!Loop_Completed_Workouts.Would_Repeat__c}, &quot;Yes&quot;, &quot;No&quot;) &amp;
IF(
    ISBLANK({!Loop_Completed_Workouts.Workout_Notes__c}),
    &quot;&quot;,
    &quot; | Notes: &quot; &amp; {!Loop_Completed_Workouts.Workout_Notes__c}
) &amp;
BR()</expression>
    </formulas>

    <formulas>
        <name>No_Workouts_Message</name>
        <dataType>String</dataType>
        <expression>BR() &amp; &quot;No completed workout sessions were found for the current user.&quot;</expression>
    </formulas>

    <formulas>
        <name>Latest_Workout_Header</name>
        <dataType>String</dataType>
        <expression>BR() &amp;
&quot;Detailed sets for the latest completed workout:&quot; &amp; BR() &amp;
&quot;Workout: &quot; &amp;
BLANKVALUE({!Get_Latest_Completed_Workout.Name}, &quot;Name not recorded&quot;) &amp;
&quot; | Date: &quot; &amp;
TEXT({!Get_Latest_Completed_Workout.Workout_Date__c}) &amp;
&quot; | Template: &quot; &amp;
BLANKVALUE({!Get_Latest_Completed_Workout.Workout_Template__r.Name}, &quot;Not recorded&quot;) &amp;
BR()</expression>
    </formulas>

    <formulas>
        <name>Current_Exercise_Header</name>
        <dataType>String</dataType>
        <expression>BR() &amp;
BLANKVALUE(
    {!Loop_Latest_Workout_Exercises.Exercise__r.Name},
    &quot;Exercise name not recorded&quot;
) &amp;
&quot;:&quot; &amp;
BR()</expression>
    </formulas>

    <formulas>
        <name>Current_Set_Line</name>
        <dataType>String</dataType>
        <expression>&quot;- Set &quot; &amp;
IF(
    ISBLANK({!Loop_Current_Exercise_Sets.Set_Number__c}),
    &quot;number not recorded&quot;,
    TEXT({!Loop_Current_Exercise_Sets.Set_Number__c})
) &amp;
&quot;: &quot; &amp;
IF(
    ISBLANK({!Loop_Current_Exercise_Sets.Weight__c}),
    &quot;Weight not recorded&quot;,
    TEXT({!Loop_Current_Exercise_Sets.Weight__c}) &amp; &quot; lb&quot;
) &amp;
&quot; x &quot; &amp;
IF(
    ISBLANK({!Loop_Current_Exercise_Sets.Reps__c}),
    &quot;reps not recorded&quot;,
    TEXT({!Loop_Current_Exercise_Sets.Reps__c}) &amp; &quot; reps&quot;
) &amp;
BR()</expression>
    </formulas>

    <interviewLabel>Review Recent Workouts {!$Flow.CurrentDateTime}</interviewLabel>
